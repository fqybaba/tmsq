.venv/
.venv-bridge/
__pycache__/
*.pyc
*.egg-info/
build/
dist/
.pytest_cache/
.ruff_cache/

# results/: small text outputs (json, yaml, csv, txt) stay in the repo at their original paths, so the
# provenance table in writeup/post.md resolves on GitHub. Large or binary artifacts are excluded here and
# shipped in the GitHub Release archive instead (see README, "Results").
results/**/*.parquet
results/**/*.pt
results/**/*.npy
results/**/*.png
results/**/*.pdf
results/**/*.log
results/_logs/

# rewrite kit: per-section drafts (assembled into writeup/rewrite_kit/*.md)
writeup/rewrite_kit/parts/
